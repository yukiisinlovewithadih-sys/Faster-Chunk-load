.github/workflows/build.yml
name: Build ChunkBoost
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Unzip source
        run: unzip -q ./*.zip -d cb
      - name: Host tests
        working-directory: cb
        run: |
          g++ -std=c++20 -O2 -Wall -Wextra -Werror -Isrc \
            src/ThreadTuner.cpp tests/test_tuner.cpp -pthread -o /tmp/t
          /tmp/t
      - uses: nttld/setup-ndk@v1
        id: ndk
        with:
          ndk-version: r26b
      - name: Configure
        working-directory: cb
        run: |
          cmake -B build -G Ninja \
            -DCMAKE_TOOLCHAIN_FILE="${{ steps.ndk.outputs.ndk-path }}/build/cmake/android.toolchain.cmake" \
            -DANDROID_ABI=arm64-v8a -DANDROID_PLATFORM=android-26 \
            -DANDROID_STL=c++_shared -DCMAKE_BUILD_TYPE=Release
      - name: Build
        working-directory: cb
        run: cmake --build build --parallel
      - name: Package
        working-directory: cb
        run: |
          "${{ steps.ndk.outputs.ndk-path }}/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-strip" --strip-unneeded build/libchunkboost.so
          python3 scripts/package_levipack.py --library build/libchunkboost.so --icon assets/icon.png --output ChunkBoost.levipack
          python3 scripts/verify_levipack.py ChunkBoost.levipack
      - uses: actions/upload-artifact@v4
        with:
          name: ChunkBoost-levipack-arm64-v8a
          path: |
            cb/ChunkBoost.levipack
            cb/build/libchunkboost.so
